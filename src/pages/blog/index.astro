---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostCard from '@/components/blog/BlogPostCard.astro';
import { baseUrl } from '@/data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPost = posts[0];
---

<BaseLayout
  title="Blog"
  description="Articles, notes and research updates from Ali Ncibi on machine learning, data engineering, and human activity recognition."
>
  <div class="container page blog-page">
    <header class="blog-hero">
      <div class="blog-hero-copy">
        <p class="blog-eyebrow">Blog</p>
        <h1 class="blog-title">Writing, notes, and research updates</h1>
        <p class="blog-subtitle">
          A compact log of ideas around machine learning, data engineering, and
          human activity recognition. Expect experiments, write-ups, and short
          notes rather than polished essays.
        </p>
        <div class="blog-actions">
          <a class="btn btn-primary" href={baseUrl('/')}>Back to Home</a>
          <a class="btn btn-secondary" href={baseUrl('/rss.xml')}>
            RSS Feed
          </a>
        </div>
      </div>

      <aside class="blog-hero-card" aria-label="Blog summary">
        <div class="blog-stat">
          <span class="blog-stat-value">{posts.length}</span>
          <span class="blog-stat-label">Published posts</span>
        </div>
        <div class="blog-stat-divider" aria-hidden="true"></div>
        <div class="blog-summary">
          <span class="blog-summary-label">Latest post</span>
          {latestPost ? (
            <>
              <a
                class="blog-summary-link"
                href={baseUrl(`/blog/${latestPost.slug}/`)}
              >
                {latestPost.data.title}
              </a>
              <span class="blog-summary-meta">
                {latestPost.data.pubDate.toLocaleDateString('en-GB', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </span>
            </>
          ) : (
            <span class="blog-summary-meta">No posts yet</span>
          )}
        </div>
      </aside>
    </header>

    {
      posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => (
            <BlogPostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              updatedDate={post.data.updatedDate}
              tags={post.data.tags}
              href={baseUrl(`/blog/${post.slug}/`)}
              body={post.body}
              featured={post.data.featured}
            />
          ))}
        </div>
      ) : (
        <p class="post-empty">No posts yet. Check back soon.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--color-primary-soft) 70%, transparent),
        transparent 45%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg-subtle) 72%, transparent),
        var(--color-bg-elevated)
      );
    box-shadow: var(--shadow-sm);
  }

  .blog-page {
    padding-top: var(--space-6);
  }

  @media (min-width: 900px) {
    .blog-hero {
      grid-template-columns: minmax(0, 1.8fr) minmax(320px, 0.9fr);
      align-items: stretch;
    }
  }

  .blog-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }

  .blog-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-primary);
    margin: 0;
  }

  .blog-title {
    font-size: var(--text-3xl);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .blog-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: var(--measure);
    margin: 0;
  }

  .blog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .blog-hero-card {
    display: flex;
    align-items: stretch;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
  }

  .blog-stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 7rem;
    text-align: center;
  }

  .blog-stat-value {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: 1;
    color: var(--color-primary);
  }

  .blog-stat-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-faint);
    margin-top: var(--space-2);
  }

  .blog-stat-divider {
    width: 1px;
    background: var(--color-border);
  }

  .blog-summary {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .blog-summary-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-faint);
  }

  .blog-summary-link {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
    color: var(--color-text);
  }

  .blog-summary-link:hover {
    color: var(--color-primary);
  }

  .blog-summary-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .post-empty {
    color: var(--color-text-muted);
    text-align: center;
    padding-block: var(--space-16);
  }
</style>
