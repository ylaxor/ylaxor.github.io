---
import { cv } from '@/data/cv';
import { baseUrl } from '@/data/site';

const { contact } = cv;

const contactLinks = [
  {
    label: contact.email,
    href: `mailto:${contact.email}`,
    icon: '<rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" />',
  },
  {
    label: contact.location,
    href: undefined,
    icon: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" />',
  },
  {
    label: contact.github,
    href: contact.github,
    icon: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />',
  },
  {
    label: contact.remote,
    href: undefined,
    icon: '<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />',
  },
];
---

<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">Hi, I'm</p>
        <h1 class="hero-name">{cv.name}</h1>
        <p class="hero-title">{cv.title}</p>
        <p class="hero-tagline">{cv.tagline}</p>

        <div class="hero-actions">
          <a class="btn btn-primary" href={baseUrl('/blog/')}>
            Read the Blog
          </a>
          <a class="btn btn-secondary" href={`${baseUrl('/')}#experience`}>
            View Experience
          </a>
          <a
            class="btn btn-secondary"
            href={contact.github}
            rel="noopener noreferrer"
            target="_blank"
          >
            GitHub
          </a>
        </div>
      </div>

      <aside class="hero-card" aria-label="Contact details">
        <h2 class="hero-card-title">Contact</h2>
        <ul class="hero-contact" role="list">
          {
            contactLinks.map((link) => (
              <li class="hero-contact-item">
                {link.href ? (
                  <a
                    class="hero-contact-link"
                    href={link.href}
                    rel={
                      link.href.startsWith('http')
                        ? 'noopener noreferrer'
                        : undefined
                    }
                  >
                    <svg
                      class="hero-contact-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={link.icon}
                    />
                    <span>{link.label}</span>
                  </a>
                ) : (
                  <span class="hero-contact-text">
                    <svg
                      class="hero-contact-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={link.icon}
                    />
                    <span>{link.label}</span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - var(--header-height));
    display: flex;
    align-items: center;
    padding-block: var(--space-8);
    background: linear-gradient(
      180deg,
      var(--color-bg-subtle) 0%,
      var(--color-bg) 100%
    );
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 768px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: var(--space-12);
      align-items: center;
    }
  }

  .hero > .container {
    width: 100%;
  }

  .hero-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .hero-name {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--space-2);
  }

  .hero-title {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    margin-bottom: var(--space-6);
  }

  .hero-tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-actions .btn {
    min-width: 10.5rem;
  }

  .hero-card {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8);
    position: sticky;
    top: calc(var(--header-height) + var(--space-8));
  }

  .hero-card-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-contact-link,
  .hero-contact-text {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text);
    overflow: hidden;
  }

  .hero-contact-link {
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .hero-contact-link:hover {
    color: var(--color-primary);
  }

  .hero-contact-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .hero-contact-link:hover .hero-contact-icon {
    color: var(--color-primary);
  }

  .hero-contact-text {
    color: var(--color-text-muted);
    cursor: default;
  }
</style>
